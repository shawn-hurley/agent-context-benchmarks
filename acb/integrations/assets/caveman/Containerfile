FROM golang:1.26.5-bookworm AS build
RUN git init /src && git -C /src remote add origin https://github.com/JuliusBrussee/caveman.git && git -C /src fetch --depth 1 origin ed37ab132393899c129bbeef2b9743ff3af19c68 && git -C /src checkout --detach FETCH_HEAD
WORKDIR /src
RUN go build -trimpath -o /caveman-engine ./engine/cmd/caveman-engine
FROM python:3.12-slim-bookworm
COPY --from=build /caveman-engine /usr/local/bin/caveman-engine
COPY server.py /opt/acb/caveman-server.py
ENV CAVEMAN_CCR_DB=/data/recovery.db
RUN mkdir -p /data
ENTRYPOINT ["python3", "/opt/acb/caveman-server.py"]
