.DS_Store
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/

# run outputs
runs/
!runs/.gitkeep

# local configuration (copy from config.example/)
config/
.config/

# vendored benchmark evaluation artifacts
# SWE-bench submodule itself is tracked, but ignore its artifacts:
SWE-bench/.venv/
SWE-bench/logs/
SWE-bench/__pycache__/
SWE-bench/*.egg-info/

bin/
*_PLAN.md
# Bundled workflow documents are source assets required by workflow.yaml.
!acb/workflows/migiq/skills/migiq/TEST_PLAN.md
!acb/workflows/kantra-rgctl/skills/rgctl/upstream/AGENTS.md
!acb/workflows/migiq/skills/rgctl/upstream/AGENTS.md
target
.rgctl/

# Runnable feature-test templates are source, not run output.
!config.example/feature-tests/runs/
!config.example/feature-tests/runs/**
